# Copy to .env.openclaw-custom and fill in. Used by scripts/dev-custom-build-run.sh
# Do not commit .env.openclaw-custom (it is gitignored).

# Required: custom OpenAI-compatible endpoint (e.g. proxy, Azure, fine-tuned)
OPENAI_CUSTOM_BASE_URL=https://your-proxy/v1

# Optional: API key (or set OPENAI_API_KEY in .env)
OPENAI_CUSTOM_API_KEY=sk-your-key

# Optional: model id (default: gpt-4o)
OPENAI_CUSTOM_MODEL=gpt-4o
